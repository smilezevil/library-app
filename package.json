{
  "name": "library-app",
  "version": "1.0.0",
  "description": "Клієнтський застосунок для управління бібліотекою на TypeScript (класи, інтерфейси, generics, модулі, простори імен), webpack та Bootstrap",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "mocha",
    "prepare": "husky",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smilezevil/library-app.git"
  },
  "keywords": [
    "typescript",
    "webpack",
    "bootstrap",
    "library"
  ],
  "author": "smilezevil",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/smilezevil/library-app/issues"
  },
  "homepage": "https://github.com/smilezevil/library-app#readme",
  "devDependencies": {
    "@types/bootstrap": "^5.2.11",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "chai": "^4.5.0",
    "css-loader": "^7.1.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "mocha": "^12.0.2",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8"
  }
}
